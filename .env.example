# Every environment variable the backend reads. Copy to .env and fill in; never commit the real salt.

# Per-team HMAC salt printed on the team slip (spec 1.2 / 5.3). Read only from the environment.
DAY1_SALT=replace-with-your-team-salt

# Secret used to sign the RBAC/login JWTs (HS256). docker-compose.yml provides a default.
JWT_SECRET=change-me

# Set by docker-compose.yml for the api container; only needed when running the API outside Docker.
DATABASE_URL=postgres://nascon:nascon@localhost:5432/nascon
REDIS_URL=redis://localhost:6379
PORT=8080
